---
import { SITE } from '../config/site';
import { FEATURED_ORDER } from '../config/affiliates';
import { getExchange } from '../data/exchanges';
import BrandMark from './BrandMark.astro';

const NAV = [
  { href: '/polymarket/', label: 'Polymarket 教程' },
  { href: '/deposit/', label: '充值提现' },
  { href: '/exchange/', label: '交易所返佣' },
  { href: '/strategy/', label: '进阶玩法' },
  { href: '/tools/', label: '工具' },
  { href: '/markets/', label: '热门市场' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
const top = getExchange(FEATURED_ORDER[0]);
---

<header class="site-header">
  <div class="container header-bar">
    <a class="brand" href="/" aria-label={`${SITE.name} 首页`}>
      <BrandMark />
      <span>{SITE.name}</span>
    </a>

    <nav class="nav-desktop" aria-label="主导航">
      {
        NAV.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <a class="btn btn--accent btn--sm header-cta" href="/exchange/" data-cta="header">
      领取交易所返佣
    </a>

    <details class="nav-mobile">
      <summary aria-label="打开菜单">
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
      </summary>
      <nav class="panel" aria-label="移动端导航">
        <a href="/">首页</a>
        {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
        <a class="btn btn--accent btn--block" href={top.goUrl} rel="sponsored nofollow" data-cta="mobile-menu" data-ex={top.id}>
          注册 {top.nameZh} 领返佣
        </a>
      </nav>
    </details>
  </div>
</header>
