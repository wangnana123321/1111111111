---
export interface Props {
  size?: number;
  class?: string;
}
const { size = 30, class: className = 'brand-mark' } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="bm-g" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#3b6cff"></stop>
      <stop offset="1" stop-color="#1a3fb8"></stop>
    </linearGradient>
  </defs>
  <rect width="32" height="32" rx="8" fill="url(#bm-g)"></rect>
  <rect x="7" y="17" width="4.5" height="8" rx="1.5" fill="#ffffff" opacity="0.55"></rect>
  <rect x="13.75" y="12" width="4.5" height="13" rx="1.5" fill="#ffffff" opacity="0.8"></rect>
  <rect x="20.5" y="7" width="4.5" height="18" rx="1.5" fill="#f5b30b"></rect>
</svg>
