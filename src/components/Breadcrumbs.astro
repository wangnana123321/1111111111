---
export interface Props {
  items: { name: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="面包屑">
  <ol>
    {
      items.map((item, i) =>
        item.href && i < items.length - 1 ? (
          <li>
            <a href={item.href}>{item.name}</a>
          </li>
        ) : (
          <li aria-current="page">{item.name}</li>
        ),
      )
    }
  </ol>
</nav>
